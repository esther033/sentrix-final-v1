# Pinned tool and chart versions for the Linux (k3s/containerd) cohort.
# Chart versions are the ones the legacy cohort actually ran (README.md).
# Tool versions below are install targets: 05-verify.sh records what is really
# installed, and the recorded file -- not this one -- is the provenance.
# Change a value only before the campaign starts; never mid-campaign.

K3S_VERSION="v1.33.4+k3s1"
HELM_VERSION="v3.17.3"
K6_VERSION="v0.57.0"

CHART_LOKI="grafana/loki:7.3.0"
CHART_TEMPO="grafana/tempo:1.24.4"
CHART_PROMETHEUS="prometheus-community/prometheus:29.30.0"
CHART_OTEL="open-telemetry/opentelemetry-collector:0.173.1"
# Not pinned in the legacy cohort. 2.7.x is the target; confirm the chart
# exists (helm search repo chaos-mesh/chaos-mesh --versions) and record it.
CHART_CHAOS_MESH="chaos-mesh/chaos-mesh:2.7.2"

PROBE_NETSHOOT_IMAGE="nicolaka/netshoot:v0.13"
PROBE_BUSYBOX_IMAGE="busybox:1.36.1"
