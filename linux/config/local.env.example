# Machine-local settings (copy to linux/config/local.env; local.env is not in Git).
# SENTRIX_ENVIRONMENT_ID: this collection PC's ID = shard name
# (campaigns/linux-v1/shards/<ID>.json), k3s node name (01-install-k3s.sh
# --node-name) and environment_id in every run record. Lowercase letters,
# digits and hyphens only. Default when unset: the hostname (must then be valid).
# The SENTRIX_ENVIRONMENT_ID environment variable overrides this file.
SENTRIX_ENVIRONMENT_ID=206-xx
