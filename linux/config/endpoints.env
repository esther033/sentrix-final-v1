# Backend endpoints read by run-attended.py, telemetry_export.py,
# quality-check.py and the k6 recorder. On k3s the services are exposed as
# NodePorts by 04-deploy-stack.sh, so nothing depends on a port-forward
# that dies with an SSH/desktop session. Source this file before any run:
#   set -a; . linux/config/endpoints.env; set +a
SENTRIX_FRONTEND_URL="http://127.0.0.1:30080"
SENTRIX_PROMETHEUS_URL="http://127.0.0.1:30090"
SENTRIX_TEMPO_URL="http://127.0.0.1:30320"
SENTRIX_LOKI_URL="http://127.0.0.1:30310"
SENTRIX_CLUSTER_PROVIDER="k3s-single-node"
# Same default as versions.env; an explicitly exported KUBECONFIG wins.
KUBECONFIG="${KUBECONFIG:-${HOME}/.kube/config}"
